APP_NAME="Hotel Guest Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hotel_platform
DB_USERNAME=hotel_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

TRUSTED_HOSTS=localhost,127.0.0.1
TENANT_SESSION_KEY=current_hotel_id
QR_PUBLIC_PREFIX=g
GUEST_SESSION_HOURS=24
VITE_APP_NAME="${APP_NAME}"

# ==============================================================================
# DEMO CREDENTIALS & PORTAL URLS
# ==============================================================================

# 1. SaaS PLATFORM SUPER ADMIN (Service Provider / Company Admin)
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=Admin12345!
PLATFORM_ADMIN_URL=http://127.0.0.1:8000/platform
PLATFORM_HOTELS_URL=http://127.0.0.1:8000/platform/hotels
PLATFORM_BILLING_URL=http://127.0.0.1:8000/platform/billing
PLATFORM_COMMUNICATIONS_URL=http://127.0.0.1:8000/platform/communications

# 2. HOTEL TENANT & OPERATIONS STAFF (Grand Azure Resort)
HOTEL_LOGIN_URL=http://127.0.0.1:8000/login
HOTEL_OPERATIONS_DASHBOARD_URL=http://127.0.0.1:8000/admin
HOTEL_ROOMS_URL=http://127.0.0.1:8000/admin/rooms
HOTEL_QR_CENTER_URL=http://127.0.0.1:8000/admin/qr-center
HOTEL_ORDERS_URL=http://127.0.0.1:8000/admin/orders
HOTEL_RESTAURANT_URL=http://127.0.0.1:8000/admin/restaurant
HOTEL_GUEST_CHAT_URL=http://127.0.0.1:8000/admin/chat

# Staff Accounts
HOTEL_STAFF_PASSWORD=Admin12345!
